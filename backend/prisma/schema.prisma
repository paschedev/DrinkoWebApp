// Esquema de Prisma equivalente a database/ddl.sql.
// Lo que Prisma no puede expresar (CHECK, índices parciales, vistas, identity)
// está agregado a mano al final de la migración inicial.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PLATFORM_ADMIN
  ORGANIZER
  STAFF

  @@map("user_role")
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  REJECTED
  EXPIRED

  @@map("order_status")
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("payment_status")
}

enum TicketStatus {
  PENDING
  ACTIVE
  REDEEMED

  @@map("ticket_status")
}

// Productoras y usuarios

model Organization {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  users      User[]
  categories Category[]
  products   Product[]
  events     Event[]

  @@map("organizations")
}

model User {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String?   @map("organization_id") @db.Uuid
  email          String    @unique
  passwordHash   String?   @map("password_hash")
  name           String
  role           UserRole
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  organization       Organization?     @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sessions           Session[]
  invitations        Invitation[]      @relation("InvitedUser")
  createdInvitations Invitation[]      @relation("InvitationCreator")
  staffAssignments   StaffAssignment[]
  redeemedTickets    Ticket[]
  changeLogs         ChangeLog[]

  @@map("users")
}

model Session {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash Bytes    @unique @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("sessions")
}

model Invitation {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash Bytes     @unique @map("token_hash")
  createdBy String    @map("created_by") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user    User @relation("InvitedUser", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  creator User @relation("InvitationCreator", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("invitations")
}

// Catálogo maestro

model Category {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  name           String
  sortOrder      Int    @default(0) @map("sort_order")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  products     Product[]

  @@unique([organizationId, name])
  @@map("categories")
}

model Product {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String   @map("organization_id") @db.Uuid
  categoryId          String?  @map("category_id") @db.Uuid
  name                String
  description         String?
  imageUrl            String?  @map("image_url")
  requiresPreparation Boolean  @default(false) @map("requires_preparation")
  isArchived          Boolean  @default(false) @map("is_archived")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  category      Category?      @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  eventProducts EventProduct[]

  @@unique([organizationId, name])
  @@map("products")
}

// Eventos

model Event {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  name             String
  accessCode       String   @unique @map("access_code")
  startsAt         DateTime @map("starts_at") @db.Timestamptz(6)
  endsAt           DateTime @map("ends_at") @db.Timestamptz(6)
  lastTicketNumber Int      @default(0) @map("last_ticket_number")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  staffAssignments StaffAssignment[]
  eventProducts    EventProduct[]
  orders           Order[]
  tickets          Ticket[]

  @@index([organizationId, startsAt], map: "events_organization_starts_at_idx")
  @@map("events")
}

model StaffAssignment {
  eventId    String   @map("event_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user  User  @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([eventId, userId])
  @@map("staff_assignments")
}

model EventProduct {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId     String   @map("event_id") @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  priceCents  Int      @map("price_cents")
  stock       Int? // NULL = sin control de stock
  isAvailable Boolean  @default(true) @map("is_available")
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  event       Event        @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product     Product      @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ticketItems TicketItem[]
  changeLogs  ChangeLog[]

  @@unique([eventId, productId])
  @@map("event_products")
}

// Compras

model Customer {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  secretHash Bytes    @unique @map("secret_hash")
  email      String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)

  orders Order[]

  @@map("customers")
}

model Order {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId        String      @map("event_id") @db.Uuid
  customerId     String      @map("customer_id") @db.Uuid
  status         OrderStatus @default(PENDING_PAYMENT)
  totalCents     Int         @map("total_cents")
  idempotencyKey String      @unique @map("idempotency_key") @db.Uuid
  expiresAt      DateTime    @map("expires_at") @db.Timestamptz(6)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  event    Event     @relation(fields: [eventId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  customer Customer  @relation(fields: [customerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payments Payment[]
  tickets  Ticket[]

  @@index([customerId, createdAt(sort: Desc)], map: "orders_customer_created_at_idx")
  @@map("orders")
}

model Payment {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId           String        @map("order_id") @db.Uuid
  status            PaymentStatus @default(PENDING)
  provider          String        @default("SIMULATED")
  externalReference String?       @map("external_reference")
  amountCents       Int           @map("amount_cents")
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  resolvedAt        DateTime?     @map("resolved_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("payments")
}

model Ticket {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId    String       @map("order_id") @db.Uuid
  eventId    String       @map("event_id") @db.Uuid
  number     Int?
  token      String?      @unique
  status     TicketStatus @default(PENDING)
  redeemedAt DateTime?    @map("redeemed_at") @db.Timestamptz(6)
  redeemedBy String?      @map("redeemed_by") @db.Uuid
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  order    Order        @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  event    Event        @relation(fields: [eventId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  redeemer User?        @relation(fields: [redeemedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  items    TicketItem[]

  @@unique([eventId, number])
  @@index([orderId], map: "tickets_order_id_idx")
  @@index([eventId, status], map: "tickets_event_status_idx")
  @@map("tickets")
}

model TicketItem {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketId       String @map("ticket_id") @db.Uuid
  eventProductId String @map("event_product_id") @db.Uuid
  productName    String @map("product_name")
  unitPriceCents Int    @map("unit_price_cents")
  quantity       Int    @db.SmallInt

  ticket       Ticket       @relation(fields: [ticketId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  eventProduct EventProduct @relation(fields: [eventProductId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([ticketId, eventProductId])
  @@index([eventProductId], map: "ticket_items_event_product_id_idx")
  @@map("ticket_items")
}

model ChangeLog {
  id             BigInt   @id @default(autoincrement())
  eventProductId String   @map("event_product_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  field          String
  oldValue       String?  @map("old_value")
  newValue       String?  @map("new_value")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  eventProduct EventProduct @relation(fields: [eventProductId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user         User         @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("change_logs")
}
