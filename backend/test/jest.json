{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".spec.ts$",
  "transform": {
    "^.+\\.ts$": "ts-jest"
  },
  "globalSetup": "<rootDir>/helpers/global-setup.ts",
  "setupFiles": ["<rootDir>/helpers/test-env.ts"],
  "testTimeout": 30000
}
